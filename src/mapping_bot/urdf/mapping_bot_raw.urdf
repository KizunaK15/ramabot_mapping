<?xml version="1.0" utf-8"?>
<robot name="Mapping_Bot">
  <mujoco>
    <compiler meshdir="meshes/" balanceinertia="true" discardvisual="false" />
  </mujoco>

  <!-- BASE LINK -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.113624" rpy="0 0 0" />
      <mass value="0.451441" />
      <inertia ixx="0.0059256" ixy="0" ixz="0" iyy="0.0062575" iyz="0" izz="0.0083862" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="base_link.STL" />
      </geometry>
      <material name="mat_base">
        <color rgba="0.894118 0.894118 0.894118 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- LINK 0 -->
  <link name="link0">
    <inertial>
      <origin xyz="0 0 0.135" rpy="0 0 0" />
      <mass value="0.033453" />
      <inertia ixx="0.00020356" ixy="0" ixz="0" iyy="0.00020356" iyz="0" izz="0.00000066" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="link0.STL" />
      </geometry>
      <material name="mat_link0">
        <color rgba="0.894118 0.894118 0.894118 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="link0.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_link" type="fixed">
    <origin xyz="0.000137 0.135272 0.067012" rpy="1.570796 0 0" />
    <parent link="base_link" />
    <child link="link0" />
  </joint>

  <!-- LINK 1 (WHEEL 1) -->
  <link name="link1">
    <inertial>
      <origin xyz="0 -0.008902 0" rpy="0 0 0" />
      <mass value="0.164682" />
      <inertia ixx="0.00023355" ixy="0" ixz="0" iyy="0.00045777" iyz="0" izz="0.00023355" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="link1.STL" />
      </geometry>
      <material name="mat_link1">
        <color rgba="0.298039 0.298039 0.298039 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="link1.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="Wheel1" type="continuous">
    <origin xyz="0 0 0" rpy="-1.570796 0 0" />
    <parent link="link0" />
    <child link="link1" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- LINK 2 (WHEEL 2) -->
  <link name="link2">
    <inertial>
      <origin xyz="0 0.000086 0" rpy="0 0 0" />
      <mass value="0.164682" />
      <inertia ixx="0.00023355" ixy="0" ixz="0" iyy="0.00045777" iyz="0" izz="0.00023355" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="link2.STL" />
      </geometry>
      <material name="mat_link2">
        <color rgba="0.298039 0.298039 0.298039 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="link2.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="Wheel2" type="continuous">
    <origin xyz="0 0 0.261184" rpy="-1.570796 0 0" />
    <parent link="link0" />
    <child link="link2" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- LINK 3 (LIDAR) -->
  <link name="link3">
    <inertial>
      <origin xyz="-0.000545 -0.000014 0.008341" rpy="0 0 0" />
      <mass value="0.171736" />
      <inertia ixx="0.00008018" ixy="0" ixz="0.00000218" iyy="0.00007651" iyz="0" izz="0.00010998" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="link3.STL" />
      </geometry>
      <material name="mat_link3">
        <color rgba="0.752941 0.752941 0.752941 0.4" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="link3.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="Lidar" type="fixed">
    <origin xyz="0 0 0.2368" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link3" />
  </joint>

  <!-- LINK 4 (CASTER 1) -->
  <link name="link4">
    <inertial>
      <origin xyz="-0.000108 0.004805 0.021603" rpy="0 0 0" />
      <mass value="0.009787" />
      <inertia ixx="0.00000117" ixy="0" ixz="0" iyy="0.00000088" iyz="0" izz="0.00000103" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="link4.STL" />
      </geometry>
      <material name="mat_link4">
        <color rgba="0.705882 0.705882 0.705882 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="link4.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="Caster1" type="fixed">
    <origin xyz="0.17337 -0.000086 0.0035" rpy="0 0 1.5705" />
    <parent link="base_link" />
    <child link="link4" />
  </joint>

  <!-- LINK 5 (CASTER 2) -->
  <link name="link5">
    <inertial>
      <origin xyz="-0.000108 0.004805 0.021603" rpy="0 0 0" />
      <mass value="0.009787" />
      <inertia ixx="0.00000117" ixy="0" ixz="0" iyy="0.00000088" iyz="0" izz="0.00000103" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="link5.STL" />
      </geometry>
      <material name="mat_link5">
        <color rgba="0.705882 0.705882 0.705882 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="link5.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="Caster2" type="fixed">
    <origin xyz="-0.14238 -0.000082 0.0035" rpy="0 0 1.5708" />
    <parent link="base_link" />
    <child link="link5" />
  </joint>
</robot>