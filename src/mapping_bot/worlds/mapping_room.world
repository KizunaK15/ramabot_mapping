<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Dinding Ruangan 6x6 Meter untuk Uji RPLidar A2M8 & SLAM -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.2 0.2 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>6.2 0.2 1.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.2 0.2 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>6.2 0.2 1.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>3.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6.0 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6.0 1.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-3.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6.0 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6.0 1.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Rintangan Tengah untuk Uji Deteksi Laser & Path Planning -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>1.2 1.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></visual>
      </link>
    </model>
    <model name="obstacle_2">
      <static>true</static>
      <pose>-1.2 -0.8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.6 1.2 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.6 1.2 0.8</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
