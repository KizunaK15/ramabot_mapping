#!/usr/bin/env python3
import math
import serial
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist, TransformStamped
from nav_msgs.msg import Odometry
from std_srvs.srv import Trigger
from tf2_ros import TransformBroadcaster


def yaw_to_quaternion(yaw: float):
    half = yaw * 0.5
    return (0.0, 0.0, math.sin(half), math.cos(half))


class MappingOdomBridge(Node):
    def __init__(self):
        super().__init__('mapping_odom_bridge')
        self.declare_parameter('serial_port', '/dev/m5stack')
        self.declare_parameter('baud_rate', 115200)
        self.declare_parameter('odom_mode', 'imu_direct')
        self.declare_parameter('wheel_separation', 0.230)
        self.declare_parameter('wheel_radius', 0.067)
        self.declare_parameter('odom_frame', 'odom')
        self.declare_parameter('base_frame', 'base_footprint')

        port = self.get_parameter('serial_port').get_parameter_value().string_value
        baud = self.get_parameter('baud_rate').get_parameter_value().integer_value
        self.odom_frame = self.get_parameter('odom_frame').get_parameter_value().string_value
        self.base_frame = self.get_parameter('base_frame').get_parameter_value().string_value

        # Konfigurasi port serial tanpa memicu DTR/RTS auto-reset pada ESP32
        self.ser = serial.Serial()
        self.ser.port = port
        self.ser.baudrate = baud
        self.ser.timeout = 0.02
        self.ser.dsrdtr = False
        self.ser.rtscts = False
        self.ser.dtr = False
        self.ser.rts = False
        self.ser.open()

        self.get_logger().info(f'Terhubung ke M5Stack Core Grey di {port} @ {baud} bps')

        self.odom_pub = self.create_publisher(Odometry, '/odom', 20)
        self.tf_broadcaster = TransformBroadcaster(self)
        self.cmd_sub = self.create_subscription(Twist, '/cmd_vel', self.cmd_vel_cb, 10)
        self.reset_srv = self.create_service(Trigger, '/reset_odom', self.reset_odom_cb)

        self.timer = self.create_timer(0.02, self.read_serial_loop)  # 50 Hz polling

    def cmd_vel_cb(self, msg: Twist):
        cmd_str = f"CMD:{msg.linear.x:.3f},{msg.angular.z:.3f}\n"
        try:
            self.ser.write(cmd_str.encode('utf-8'))
        except serial.SerialException as e:
            self.get_logger().error(f'Gagal kirim CMD serial: {e}')

    def reset_odom_cb(self, request, response):
        try:
            self.ser.write(b"RESET\n")
            response.success = True
            response.message = "Odometri & heading M5Stack di-reset ke 0"
        except serial.SerialException as e:
            response.success = False
            response.message = str(e)
        return response

    def read_serial_loop(self):
        try:
            while self.ser.in_waiting > 0:
                line = self.ser.readline().decode('utf-8', errors='ignore').strip()
                if not line.startswith('ODO:'):
                    continue
                parts = line[4:].split(',')
                if len(parts) < 5:
                    continue

                x = float(parts[0])
                y = float(parts[1])
                theta = -float(parts[2])
                vx = float(parts[3])
                vth = -float(parts[4])

                now = self.get_clock().now().to_msg()
                qx, qy, qz, qw = yaw_to_quaternion(theta)

                tf_msg = TransformStamped()
                tf_msg.header.stamp = now
                tf_msg.header.frame_id = self.odom_frame
                tf_msg.child_frame_id = self.base_frame
                tf_msg.transform.translation.x = x
                tf_msg.transform.translation.y = y
                tf_msg.transform.translation.z = 0.0
                tf_msg.transform.rotation.x = qx
                tf_msg.transform.rotation.y = qy
                tf_msg.transform.rotation.z = qz
                tf_msg.transform.rotation.w = qw
                self.tf_broadcaster.sendTransform(tf_msg)

                odom = Odometry()
                odom.header.stamp = now
                odom.header.frame_id = self.odom_frame
                odom.child_frame_id = self.base_frame
                odom.pose.pose.position.x = x
                odom.pose.pose.position.y = y
                odom.pose.pose.orientation.x = qx
                odom.pose.pose.orientation.y = qy
                odom.pose.pose.orientation.z = qz
                odom.pose.pose.orientation.w = qw
                odom.twist.twist.linear.x = vx
                odom.twist.twist.angular.z = vth
                self.odom_pub.publish(odom)
        except Exception as e:
            self.get_logger().warn(f'Serial parse warning: {e}')


def main(args=None):
    rclpy.init(args=args)
    node = MappingOdomBridge()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if node.ser.is_open:
            node.ser.write(b"CMD:0.000,0.000\n")
            node.ser.close()
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()