<?xml version="1.0"?>
<package format="3">
  <name>ramabot_mapping</name>
  <version>0.1.0</version>
  <description>Standalone 2D LiDAR mapping package for RAMABOT V3 map acquisition</description>
  <maintainer email="kizuna@ramabot.local">kizuna</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
